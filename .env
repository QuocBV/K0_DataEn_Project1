# Copy of .env.example - dev defaults
PIP_INDEX_URL=https://jfrog.ssi.com.vn/artifactory/api/pypi/pypi-remote/simple

# Dagster orchestration
DAGSTER_POSTGRES_PASSWORD=dagster_dev_password
DAGSTER_ADMIN_PASSWORD=admin

# Airbyte connection IDs (tự tạo trên Airbyte UI, ghi UUID vào đây)
CONN_MSSQL_COMMON=
CONN_MSSQL_EQUITY=
CONN_MSSQL_DERIVATIVES=
CONN_MSSQL_OEF=
CONN_HR_API=

# AWS S3 - Data Lake
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=s3.amazonaws.com
S3_DATA_BUCKET=ssi-data
S3_REPORT_BUCKET=ssi-report

# MSSQL (source OLTP)
MSSQL_HOST=sqlserver
MSSQL_EXPORT_USER=sa
MSSQL_EXPORT_PASSWORD=SqlServer2022!Pass
MSSQL_SA_PASSWORD=SqlServer2022!Pass

# Trino (SQL engine for Iceberg)
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin
TRINO_PASSWORD=

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083

OPS_ALERT_WEBHOOK_URL=

# hr-api auth
HR_API_AUTH_MODE=none
HR_API_KEY=
HR_API_JWT_SECRET=
