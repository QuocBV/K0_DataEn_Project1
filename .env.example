# Copy to .env (gitignored) and fill in real values. Never commit the real .env file.
PIP_INDEX_URL=https://jfrog.ssi.com.vn/artifactory/api/pypi/pypi-remote/simple

AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# AWS S3 - already provisioned, fill in credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=s3.amazonaws.com
S3_RAW_BUCKET=ssi-raw
S3_BRONZE_BUCKET=ssi-bronze
S3_SILVER_BUCKET=ssi-silver
S3_GOLD_BUCKET=ssi-gold

# MSSQL (source OLTP)
MSSQL_HOST=
MSSQL_EXPORT_USER=
MSSQL_EXPORT_PASSWORD=
MSSQL_SA_PASSWORD=

# Trino (SQL engine for Iceberg)
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin
TRINO_PASSWORD=

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083

OPS_ALERT_WEBHOOK_URL=

# hr-api auth - HR_API_AUTH_MODE: none (local dev only) / api_key / jwt. Set the matching secret
# below and keep Airbyte's hr_api source config in sync.
HR_API_AUTH_MODE=none
HR_API_KEY=
HR_API_JWT_SECRET=