# Copy to .env (gitignored) and fill in real values. Never commit the real .env file.
PIP_INDEX_URL=https://jfrog.ssi.com.vn/artifactory/api/pypi/pypi-remote/simple

# Dagster orchestration
DAGSTER_POSTGRES_PASSWORD=
DAGSTER_ADMIN_PASSWORD=

# Airbyte connection IDs (tự tạo trên Airbyte UI, ghi UUID vào đây)
CONN_MSSQL_COMMON=
CONN_MSSQL_EQUITY=
CONN_MSSQL_DERIVATIVES=
CONN_MSSQL_OEF=
CONN_HR_API=

# AWS S3 - Data Lake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=s3.amazonaws.com
S3_DATA_BUCKET=ssi-data
S3_REPORT_BUCKET=ssi-report

# MSSQL (source OLTP)
MSSQL_HOST=
MSSQL_EXPORT_USER=
MSSQL_EXPORT_PASSWORD=
MSSQL_SA_PASSWORD=

# Trino (SQL engine for Iceberg)
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin
TRINO_PASSWORD=

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083

OPS_ALERT_WEBHOOK_URL=

# hr-api auth
HR_API_AUTH_MODE=none
HR_API_KEY=
HR_API_JWT_SECRET=