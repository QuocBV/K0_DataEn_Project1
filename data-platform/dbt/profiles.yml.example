# Copy to profiles.yml (gitignored) and fill in real values. Never commit real credentials.
# dbt connects to Trino's ssi_data catalog (gold dim/fact) and reads ssi_report via source().
ssi_trading_analytics:
  target: dev
  outputs:
    dev:
      type: trino
      method: none
      user: "{{ env_var('TRINO_USER', 'admin') }}"
      password: "{{ env_var('TRINO_PASSWORD', '') }}"
      database: gold
      schema: gold
      host: "{{ env_var('TRINO_HOST', 'localhost') }}"
      port: "{{ env_var('TRINO_PORT', '8080') | int }}"
      threads: 8
      http_scheme: "{{ env_var('TRINO_HTTP_SCHEME', 'http') }}"
      session_properties:
        query_max_run_time: 10m
    prod:
      type: trino
      method: ldap
      user: "{{ env_var('TRINO_USER') }}"
      password: "{{ env_var('TRINO_PASSWORD') }}"
      database: gold
      schema: gold
      host: "{{ env_var('TRINO_HOST') }}"
      port: "{{ env_var('TRINO_PORT') | int }}"
      threads: 16
      http_scheme: https
      session_properties:
        query_max_run_time: 30m