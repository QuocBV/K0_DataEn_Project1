# Copy to profiles.yml (gitignored) or point --profiles-dir elsewhere.
# dbt connects to Spark Thrift Server (Iceberg catalog) for Gold dim/fact and Reporting marts.
ssi_trading_analytics:
  target: dev
  outputs:
    dev:
      type: spark
      method: thrift
      host: "{{ env_var('SPARK_THRIFT_HOST', 'spark-thriftserver') }}"
      port: "{{ env_var('SPARK_THRIFT_PORT', '10000') | int }}"
      user: "{{ env_var('SPARK_THRIFT_USER', 'admin') }}"
      schema: gold
      database: gold
      threads: 8
    prod:
      type: spark
      method: thrift
      host: "{{ env_var('SPARK_THRIFT_HOST') }}"
      port: "{{ env_var('SPARK_THRIFT_PORT') | int }}"
      user: "{{ env_var('SPARK_THRIFT_USER') }}"
      schema: gold
      database: gold
      threads: 16